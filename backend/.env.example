# Virtual ChemLab Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file with secrets to Git.

PORT=4000
CORS_ORIGIN=http://localhost:5173

# AI Reaction Predictor Keys (Optional)
# 1. Groq (Ultra-Fast & Free Tier): https://console.groq.com/keys
# GROQ_API_KEY=gsk_...

# 2. Google Gemini (Generous Free Tier): https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=

# 3. OpenAI: https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# 4. Anthropic Claude: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# Default provider: "groq" | "gemini" | "openai" | "anthropic"
DEFAULT_AI_PROVIDER=groq
